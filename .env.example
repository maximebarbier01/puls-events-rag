# Clé API Mistral (https://console.mistral.ai/) - ne jamais commiter la vraie valeur
MISTRAL_API_KEY=your_mistral_api_key_here

# Jeton requis pour appeler POST /rebuild (header X-Rebuild-Token) - sans cette
# variable, l'endpoint refuse toutes les requêtes par défaut.
REBUILD_TOKEN=your_rebuild_token_here
