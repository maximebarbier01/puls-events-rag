# Environnement et outillage local (pas nécessaire à l'exécution de l'API)
.venv/
.git/
.github/
.claude/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
htmlcov/
coverage.xml
.coverage

# Secrets - ne jamais copier dans une image Docker
.env

# Données et index : montés en volumes au runtime, pas copiés dans l'image
data/
index/

# Code non nécessaire à l'exécution de l'API (scripts CLI, tests, docs)
scripts/
tests/
docs/
eval/
notebooks/

# Autres
.vscode/
.DS_Store
.ipynb_checkpoints/
